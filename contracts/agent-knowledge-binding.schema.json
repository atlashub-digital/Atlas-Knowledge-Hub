{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AKH Agent Knowledge Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "pack_version",
    "deployment_ref",
    "tenant_id",
    "libraries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^PACK-[0-9]{3}$"
    },
    "pack_version": {
      "type": "string"
    },
    "deployment_ref": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      }
    },
    "libraries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "library_ref",
          "grant_ref"
        ],
        "properties": {
          "library_ref": {
            "type": "string"
          },
          "grant_ref": {
            "type": "string"
          },
          "minimum_lifecycle": {
            "enum": [
              "verified",
              "published"
            ]
          }
        }
      }
    },
    "denied_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "live_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_human_review": {
      "type": "boolean"
    }
  }
}
